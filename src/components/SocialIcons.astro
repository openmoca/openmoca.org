---
// Starlight's header links (the GitHub icon), with a text link to the live example site before them. The same
// component sits in the phone menu, so the link is there too.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<a class="openmoca-try" href="https://try.openmoca.org">Try it</a>
<Default />

<style>
	.openmoca-try {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		white-space: nowrap;
		padding: 0.25em 0.75em;
		border: 1px solid var(--sl-color-text-accent);
		border-radius: 999px;
		margin-inline-end: 0.5rem;
	}
	.openmoca-try:hover {
		color: var(--sl-color-black);
		background: var(--sl-color-text-accent);
	}
</style>
