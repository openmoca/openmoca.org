---
// One footer for both zones: Starlight's own (edit link, previous and next in the docs), the site's links, the
// version these pages document, and who maintains the project.
// One "maintained by" line, linked to the maintainer's site: the standard stays vendor-independent.
// The trade mark notice says who holds the name; ™ until the UK application is registered, never ®.
import Default from '@astrojs/starlight/components/Footer.astro';
import generated from '../generated.json';
---

<Default />
<nav class="openmoca-footer-links" aria-label="Footer">
	<ul>
		<li><a href="/commitment/">The OpenMOCA Commitment</a></li>
		<li><a href="/conformant/">OpenMOCA Conformant</a></li>
		<li><a href="/releases/">Releases</a></li>
		<li><a href="/try/">Ways to try</a></li>
		<li><a href="https://github.com/openmoca">GitHub</a></li>
		<li><a href="/contact/">Contact</a></li>
		<li><a href="/privacy/">Privacy</a></li>
		<li><a href="/project/licence/">Licence</a></li>
		<li><a href="/project/governance/">Governance</a></li>
	</ul>
</nav>
<p class="openmoca-footer">
	Documents OpenMOCA {generated.specVersion} · Apache-2.0 · Maintained by <a href="https://piandmash.com">PI &amp; Mash</a>
	<br />
	OpenMOCA™ is a trade mark of PI &amp; Mash Solutions Ltd. The Apache License covers the code and text,
	not the name.
</p>

<style>
	.openmoca-footer {
		margin-top: 1.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.openmoca-footer a, .openmoca-footer-links a { color: var(--moca-link); }
	.openmoca-footer-links { margin-top: 1.5rem; border-top: 1px solid var(--sl-color-hairline); padding-top: 1rem; }
	.openmoca-footer-links ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; list-style: none; padding: 0; margin: 0; font-size: var(--sl-text-sm); }
	.openmoca-footer-links li { margin: 0; }
	.openmoca-footer a:hover { color: var(--moca-link-hover); }
</style>
