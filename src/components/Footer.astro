---
// One footer for every page, main site and docs: the version (from the release switch, release.json), About,
// Contact, Privacy, Governance, GitHub, the licence (linked to the Licence page) and who maintains the project; then the
// trade mark notice. The docs keep Starlight's own footer above it (edit link, previous and next); the main site's
// pages are not a sequence, so they have none. One "maintained by" line, linked to the maintainer's site: the standard
// stays vendor-independent. ™ until the UK application is registered, never ®.
import Default from '@astrojs/starlight/components/Footer.astro';
import release from '../../release.json';
import { isMain as inMain } from '../zones';

const isMain = inMain(Astro.locals.starlightRoute.id);
const version = release.released ? release.version : release.previous;
---

{!isMain && <Default />}
<p class="openmoca-footer">
  Documents OpenMOCA {version} · <a href="/about/">About</a> · <a href="/contact/">Contact</a> ·{' '}
  <a href="/privacy/">Privacy</a> · <a href="/project/governance/">Governance</a> ·{' '}
  <a href="https://github.com/openmoca">GitHub</a> · <a href="/project/licence/">Apache-2.0</a> · Maintained
  by <a href="https://piandmash.com">PI &amp; Mash</a>
  <br />
  OpenMOCA™ is a trade mark of PI &amp; Mash Solutions Ltd. The Apache License covers the code and text,
  not the name.
</p>

<style>
	.openmoca-footer {
		margin-top: 1.5rem;
		line-height: 1.7;
		border-top: 1px solid var(--sl-color-hairline);
		padding-top: 1rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.openmoca-footer a { color: var(--moca-link); }
	.openmoca-footer a:hover { color: var(--moca-link-hover); }
</style>
